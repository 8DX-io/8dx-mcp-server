{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.8DX-io/8dx-mcp-server",
  "title": "8DX MCP Server",
  "description": "8DX DEX aggregator tools for token discovery, swap quotes and limit orders.",
  "repository": {
    "url": "https://github.com/8DX-io/8dx-mcp-server",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@8dx/8dx-mcp-server",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EIGHTDX_API_BASE_URL",
          "description": "Optional 8DX REST API base URL override.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "https://swap.ggp.gg"
        },
        {
          "name": "EIGHTDX_REQUEST_TIMEOUT_MS",
          "description": "Request timeout in milliseconds.",
          "format": "number",
          "isRequired": false,
          "isSecret": false,
          "default": "30000"
        }
      ]
    }
  ]
}
